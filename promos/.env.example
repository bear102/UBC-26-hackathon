# Copy to .env.local on the machine that runs the app (the user's PC). NEVER commit real values.
# --- Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Public origin customers' phones reach (stable hostname, D16). QR codes and backup links embed it.
PUBLIC_URL=http://localhost:5380
# Merchant console login: open /api/login?t=<token> once per browser. Empty = no login (local only!).
HH_ADMIN_TOKEN=
# Runtime keys are read from keys/<name>.json (npm run keys): merchant, attestor, relayer, crank.
# --- Gemini prediction markets (SPEC §4.2). Production has the weather/sports/crypto books.
# Sandbox (https://api.sandbox.gemini.com, separate account) has only crypto + commodities: set BOTH bases to the
# sandbox and HH_ALLOW_CRYPTO=1, because symbols must come from the same venue you trade on.
GEMINI_PUBLIC_BASE=https://api.gemini.com
GEMINI_TRADE_BASE=https://api.gemini.com
GEMINI_API_KEY_A=
GEMINI_API_SECRET_A=
GEMINI_API_KEY_B=
GEMINI_API_SECRET_B=
# live = real Gemini orders (needs keys A+B); paper = simulated fills on the live public book, labelled PAPER in the UI.
# Unset = live if keys A+B are present, else paper.
HEDGE_MODE=
DAILY_BUDGET_USD=25
PRICE_CEILING=0.75
LIMIT_SLIPPAGE=0.02
# Show crypto 5/15-min and hourly events in the promo catalog (fast test settlements)
HH_ALLOW_CRYPTO=
# --- Card scan LLM (optional; templates without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Alternative scan LLM (used only when no Anthropic key is set): Google AI Studio
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# Merchant display name on receipts
MERCHANT_NAME=Guadalupe Watch Party (demo merchant: our team)
